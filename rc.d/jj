#!/bin/sh

# PROVIDE: jj
# REQUIRE: LOGIN mysql
# KEYWORD: shutdown

. /etc/rc.subr

name="jj"
rcvar=jj_enable

load_rc_config "${name}"

: ${jj_enable="NO"}
: ${jj_home="/usr/local/boot/"}
: ${jj_args=""}
: ${jj_java_opts="-Xms12G -Xmx16G -Dlog4j2.formatMsgNoLookups=true -XX:+UseG1GC"}
: ${jj_user="jj"}
: ${jj_group="jj"}
: ${jj_log_file="/var/log/jj.log"}
: ${jj_stop_timeout="60"}

pidfile="/var/run/jj/jj.pid"
command="/usr/sbin/daemon"
java_cmd="/usr/local/bin/java"
procname="${java_cmd}"
command_args="-p ${pidfile} ${java_cmd} ${jj_java_opts} ${jj_args} -jar ${jj_home}/jj.jar > ${jj_log_file} 2>&1"
required_files="${java_cmd}"

start_precmd="jj_prestart"
start_cmd="jj_start"
stop_cmd="${name}_stop"

jj_prestart() {
        if [ ! -f "${jj_log_file}" ]; then
                touch "${jj_log_file}"
                chown "${jj_user}:${jj_group}" "${jj_log_file}"
                chmod 640 "${jj_log_file}"
        fi
        if [ ! -d "/var/run/jj" ]; then
                install -d -o "${jj_user}" -g "${jj_group}" -m 750 "/var/run/jj"
        fi
}

jj_start()
{
        check_startmsgs && echo "Starting ${name}."
        su -l ${jj_user} -c "exec ${command} ${command_args} ${rc_arg}"
}

jj_stop()
{
        if [ ! -f "$pidfile" ]; then
                echo "${name} not running."
                return 0
        fi
        pid=$(cat "$pidfile")
        if ! kill -0 "$pid" 2>/dev/null; then
                echo "${name} not running."
                return 0
        fi

        # SIGTERM lets Spring finish and close the database pool. Killing the JVM outright drops
        # every MySQL connection at once, which has been crashing mysqld.
        echo "Stopping ${name}."
        kill -TERM "$pid"
        i=0
        while kill -0 "$pid" 2>/dev/null; do
                if [ "$i" -ge "${jj_stop_timeout}" ]; then
                        echo "${name} did not stop after ${jj_stop_timeout} seconds, killing it."
                        kill -KILL "$pid"
                        break
                fi
                sleep 1
                i=$((i + 1))
        done
}

load_rc_config $name
run_rc_command "$1"
